# Vite proxy forwards same-origin /api and /sanctum to this local Laravel server.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional. Leave unset when React and Laravel share /api through proxy/nginx.
# When Frontend is on another domain, set to the live Laravel HTTPS /api URL.
# VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN/api
